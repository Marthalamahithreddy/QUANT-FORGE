# QuantForge local development environment.
#
# Copy to `.env` and adjust as needed:
#
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials.
#
# Docker Compose reads this file automatically from the repository root.
# The API additionally reads `apps/api/.env` (see apps/api/README.md) and always
# accepts these variables from the real process environment, which takes priority.
#
# The defaults below already match the values compiled into
# `quantforge.core.config`, so the stack works with no .env file at all.
#
# How to read this file. Every variable is tagged:
#   [serve]   needed to SERVE the persisted, read-only product (API + web)
#   [ingest]  needed only by the ingestion CLI; the API starts and serves without it
#   [dev]     local-development convenience or an optional tuning knob
# A production deployment (QF_ENVIRONMENT=production) additionally REFUSES TO START unless
# QF_DATABASE_URL is a real (non-development) database and QF_CORS_ORIGINS is set explicitly.
# Provider keys, the SEC identity and Redis are never required to serve. See docs/operations-runbook.md.

# ── PostgreSQL (Docker Compose) ──────────────────────────────────────────────
POSTGRES_DB=quantforge
POSTGRES_USER=quantforge
# Local development only. Replace with a real secret for any shared environment.
POSTGRES_PASSWORD=local-dev-only-not-a-secret
# Host port published by Docker Compose. Change if 5432 is already in use.
POSTGRES_PORT=5432

# ── Redis (Docker Compose) ───────────────────────────────────────────────────
# Host port published by Docker Compose. Change if 6379 is already in use.
REDIS_PORT=6379

# ── API (QF_ prefix is required by pydantic-settings) ───────────────────────
# Must use the psycopg driver. Keep this value in sync with the POSTGRES_*
# variables above.
# [serve] PostgreSQL. In production use a real login, e.g.
#   postgresql+psycopg://<user>:<password>@<host>:5432/<database>
# The development logins in this file ("quantforge" / "local-dev-only-not-a-secret") are REFUSED
# when QF_ENVIRONMENT=production.
QF_DATABASE_URL=postgresql+psycopg://quantforge:local-dev-only-not-a-secret@localhost:5432/quantforge
# [dev] Redis is optional: no serving path uses it. It is reported by /api/v1/health/ready but never
# gates readiness. Leave the value BLANK (QF_REDIS_URL=) to say "Redis is not configured".
QF_REDIS_URL=redis://localhost:6379/0
# [serve] local | development | staging | production. production switches on the startup guards,
# disables /docs and /openapi.json, and refuses QF_DEBUG=true.
QF_ENVIRONMENT=local
# [serve] Browser origins allowed to read the API (comma-separated, or a JSON array). The localhost
# default applies outside production only; production must list its own origin(s) explicitly, and
# "*" is refused there. Only GET/HEAD/OPTIONS are ever allowed (the API is read-only).
QF_CORS_ORIGINS=http://localhost:3000
# [dev] Credentialed CORS is off by default (there is no cookie/session auth). Opt in only with
# explicit origins; "*" is refused while it is true.
# QF_CORS_ALLOW_CREDENTIALS=false
# [dev] Seconds libpq waits to open a connection (1-60) and the server-side cap on any one statement
# (1-3600). Raise the statement cap only for a deliberately long bulk ingestion.
# QF_DB_CONNECT_TIMEOUT_SECONDS=5
# QF_DB_STATEMENT_TIMEOUT_SECONDS=60
QF_LOG_LEVEL=INFO

# ── Massive market data provider [ingest] ────────────────────────────────────
# Real key goes in apps/api/.env or the process environment; never commit it. Not needed to serve.
# Without a key, `quantforge ingestion reference` fails fast with a clear error.
QF_MASSIVE_API_KEY=
# Provider base URL. Override only for a proxy or a provider-compatible sandbox.
QF_MASSIVE_BASE_URL=https://api.massive.com
# Outbound request timeout and retry policy for the provider client.
QF_MASSIVE_REQUEST_TIMEOUT_SECONDS=20
QF_MASSIVE_MAX_RETRIES=3
QF_MASSIVE_RETRY_BASE_DELAY_SECONDS=0.5
# Minimum spacing between provider requests (rate limiting).
QF_MASSIVE_MIN_REQUEST_INTERVAL_SECONDS=0.2
# [ingest] Where raw provider responses and run manifests are stored. Back this directory up together
# with the database (the database's provenance points at these files); see docs/operations-runbook.md.
QF_INGESTION_RAW_ROOT=data/raw

# ── Finnhub earnings provider [ingest] ──────────────────────────────────────
# Earnings only -- Massive's own earnings endpoint (Benzinga) is entitlement-
# blocked (HTTP 403) under the configured plan. Does not replace Massive for
# reference/daily-bar data. Real key goes in apps/api/.env or the process
# environment; never commit it.
QF_FINNHUB_API_KEY=
QF_FINNHUB_BASE_URL=https://finnhub.io/api/v1

# ── SEC EDGAR [ingest] ───────────────────────────────────────────────────────
# The SEC needs no key, but its fair-access policy requires every request to say who is making it.
# Format: "<application name> <your contact email or URL>". Required only by the SEC ingestion
# commands (sec-filings, sec-filings-history, sec-filing-acceptance); never defaulted, never stored,
# never returned by any endpoint. Leave blank until you run SEC ingestion.
QF_SEC_USER_AGENT=
QF_SEC_BASE_URL=https://data.sec.gov

# ── Web application (Next.js) [serve] ────────────────────────────────────────
# Must be NEXT_PUBLIC_* to be readable by the browser bundle. Copy this value to
# apps/web/.env.local; Next.js does not read the repository-root .env.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
