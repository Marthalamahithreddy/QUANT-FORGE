# QuantForge local development environment.
#
# Copy to `.env` and adjust as needed:
#
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials.
#
# Docker Compose reads this file automatically from the repository root.
# The API additionally reads `apps/api/.env` (see apps/api/README.md) and always
# accepts these variables from the real process environment, which takes priority.
#
# The defaults below already match the values compiled into
# `quantforge.core.config`, so the stack works with no .env file at all.

# ── PostgreSQL (Docker Compose) ──────────────────────────────────────────────
POSTGRES_DB=quantforge
POSTGRES_USER=quantforge
# Local development only. Replace with a real secret for any shared environment.
POSTGRES_PASSWORD=local-dev-only-not-a-secret
# Host port published by Docker Compose. Change if 5432 is already in use.
POSTGRES_PORT=5432

# ── Redis (Docker Compose) ───────────────────────────────────────────────────
# Host port published by Docker Compose. Change if 6379 is already in use.
REDIS_PORT=6379

# ── API (QF_ prefix is required by pydantic-settings) ───────────────────────
# Must use the psycopg driver. Keep this value in sync with the POSTGRES_*
# variables above.
QF_DATABASE_URL=postgresql+psycopg://quantforge:local-dev-only-not-a-secret@localhost:5432/quantforge
QF_REDIS_URL=redis://localhost:6379/0
QF_ENVIRONMENT=local
# Comma-separated list, or a JSON array. Must not contain "*" while
# QF_CORS_ALLOW_CREDENTIALS is true.
QF_CORS_ORIGINS=http://localhost:3000
QF_LOG_LEVEL=INFO

# ── Massive market data provider (ingestion) ─────────────────────────────────
# Real key goes in apps/api/.env or the process environment; never commit it.
# Without a key, `quantforge ingestion reference` fails fast with a clear error.
QF_MASSIVE_API_KEY=
# Provider base URL. Override only for a proxy or a provider-compatible sandbox.
QF_MASSIVE_BASE_URL=https://api.massive.com
# Outbound request timeout and retry policy for the provider client.
QF_MASSIVE_REQUEST_TIMEOUT_SECONDS=20
QF_MASSIVE_MAX_RETRIES=3
QF_MASSIVE_RETRY_BASE_DELAY_SECONDS=0.5
# Minimum spacing between provider requests (rate limiting).
QF_MASSIVE_MIN_REQUEST_INTERVAL_SECONDS=0.2
# Where raw provider responses and run manifests are stored.
QF_INGESTION_RAW_ROOT=data/raw

# ── Finnhub earnings provider (ingestion) ───────────────────────────────────
# Earnings only -- Massive's own earnings endpoint (Benzinga) is entitlement-
# blocked (HTTP 403) under the configured plan. Does not replace Massive for
# reference/daily-bar data. Real key goes in apps/api/.env or the process
# environment; never commit it.
QF_FINNHUB_API_KEY=
QF_FINNHUB_BASE_URL=https://finnhub.io/api/v1

# ── Web application (Next.js) ────────────────────────────────────────────────
# Must be NEXT_PUBLIC_* to be readable by the browser bundle. Copy this value to
# apps/web/.env.local; Next.js does not read the repository-root .env.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
