# ── Local toolchains (uv-installed Node, any vendored binaries) ───────────────
# Node 24 LTS is installed here by scripts/bootstrap.sh|.ps1. Never commit.
/.tools/

# ── Operating system ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── Environment / secrets ───────────────────────────────────────────────────
# .env holds real credentials. Only .env.example is tracked.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
secrets/

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.python-version.local

# Byte-compiled / build artefacts
build/
dist/
develop-eggs/
*.egg-info/
.eggs/
.installed.cfg

# Test / type / lint caches and reports
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.hypothesis/

# Notebooks
.ipynb_checkpoints/

# ── Node / Next.js ──────────────────────────────────────────────────────────
node_modules/
.npm/
.pnpm-store/
.yarn/
.yarn-integrity

.next/
out/
.turbo/
.turbo-cache/
next-env.d.ts
*.tsbuildinfo

# Test output
coverage/
playwright-report/
test-results/

# ── Analytics data (never commit market or derived datasets) ────────────────
# Directory structure is preserved via .gitkeep; contents are ignored.
data/raw/*
data/processed/*
data/parquet/*
!data/**/.gitkeep

# ── Logs & temp ─────────────────────────────────────────────────────────────
*.log
logs/
tmp/
temp/
.cache/

# ── Editors ─────────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json.example
*.swp
*.swo
*~
